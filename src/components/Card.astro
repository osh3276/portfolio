---
interface Props {
	imageSrc: string;
	title: string;
	subtitle: string;
	href: string;
}

const { imageSrc, title, subtitle, href } = Astro.props;
---

<div class="rounded-2xl overflow-hidden bg-(--bg-2) text-(--fg-1) shadow-[0_10px_20px_rgba(0,0,0,0.2)] outline-2 outline-transparent transition duration-200 hover:outline-(--accent-1)">
	<a href={href} class="block text-inherit no-underline">
		<img src={imageSrc} alt={title} class="w-full h-[180px] object-cover" />
		<div class="p-4">
			<h1 class="m-0 text-[1.75rem] font-medium">{title}</h1>
			<p class="mt-2 text-base text-(--fg-2)">{subtitle}</p>
		</div>
	</a>
</div>
