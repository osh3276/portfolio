---
interface Props {
	imageSrc: string;
	title: string;
	subtitle: string;
	href: string;
}

const { imageSrc, title, subtitle, href } = Astro.props;
---

<a
	href={href}
	class="w-[calc(33.333%-1.5rem)] min-w-[280px] max-w-[380px] p-3 outline -outline-offset-1 outline-(--fg-1) flex flex-col justify-start items-start overflow-hidden no-underline transition duration-200 hover:outline-(--accent-1)"
>
	<img src={imageSrc} alt={title} class="self-stretch h-52 object-cover" />
	<h2 class="mt-2 self-stretch justify-center text-(--fg-1) text-3xl italic">
		{title}
	</h2>
	<p class="self-stretch justify-center text-(--fg-2)">{subtitle}</p>
</a>
