---
import '../styles/global.css';
import 'prismjs/themes/prism-tomorrow.css';

interface Props {
	title: string;
	description?: string;
	showHeader?: boolean;
	showFooter?: boolean;
}

const {
	title,
	description = 'oliver huang - physics, mathematics, and computer science student',
	showHeader = true,
	showFooter = true
} = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		{showHeader && (
			<header>
				<a href="/" class="title-link"><span class="title">oliver huang</span></a>
				<nav>
					<a href="/about" class="nav-item">about</a>
					<a href="/projects" class="nav-item">projects</a>
					<a href="/blog" class="nav-item">blog</a>
					<a href="/contact" class="nav-item">contact</a>
				</nav>
			</header>
		)}

		<slot />

		{showFooter && (
			<footer>
				<div class="footer-content">
					<div class="footer-links">
						<a
							href="https://www.linkedin.com/in/oliver-huang-931947232/"
							target="_blank"
							rel="noopener noreferrer"
							class="footer-link"
						>
							<svg class="inline-block h-5 w-5" fill="currentColor" viewBox="0 0 256 256">
								<path d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24ZM96,176a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0ZM88,96a12,12,0,1,1,12-12A12,12,0,0,1,88,96Zm96,80a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140Z"></path>
							</svg>
							linkedin
						</a>
						<a
							href="https://github.com/osh3276"
							target="_blank"
							rel="noopener noreferrer"
							class="footer-link"
						>
							<svg class="inline-block h-5 w-5" fill="currentColor" viewBox="0 0 256 256">
								<path d="M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68Z"></path>
							</svg>
							github
						</a>
					</div>
				</div>
			</footer>
		)}

		<style>
			header {
				background-color: var(--bg-1);
				color: var(--fg-1);
				padding: 1rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-family: 'Spectral', monospace;
				transition: background-color 0.3s ease;
			}

			.title-link {
				text-decoration: none;
				color: inherit;
			}

			nav {
				display: flex;
				gap: 2.5rem;
				margin-right: 1.5rem;
			}

			.nav-item {
				text-decoration: none;
				color: var(--fg-1);
				font-size: 1.2rem;
				position: relative;
				transition: transform 0.3s ease-in-out;
			}

			.nav-item::before {
				content: '→';
				position: absolute;
				left: 0;
				width: 100%;
				opacity: 0;
				transition:
					opacity 0.3s ease-in-out,
					transform 0.3s ease-in-out;
			}

			.nav-item:hover {
				transform: translateX(15px);
			}

			.nav-item:hover::before {
				opacity: 1;
				transform: translateX(-15px);
			}

			.title {
				position: relative;
				display: inline-block;
				font-size: 2rem;
				text-decoration: underline transparent;
				transition: text-decoration 0.2s ease-in-out;
			}

			.title:hover {
				cursor: pointer;
				text-decoration: underline currentColor;
			}

			footer {
				background-color: var(--bg-1);
				color: var(--fg-1);
				padding: 2rem 1rem;
				margin-top: 3rem;
				border-top: 1px solid var(--bg-2);
				font-family: 'overpass mono', monospace;
			}

			.footer-content {
				max-width: 1200px;
				margin: 0 auto;
				display: flex;
				justify-content: center;
			}

			.footer-links {
				display: flex;
				gap: 2rem;
				align-items: center;
			}

			.footer-link {
				text-decoration: none;
				color: var(--fg-1);
				font-size: 1rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				transition: color 0.3s ease;
			}

			.footer-link:hover {
				color: var(--accent-1);
			}

			@media (max-width: 768px) {
				.title-link {
					display: none;
				}

				header {
					justify-content: center;
				}

				.footer-links {
					gap: 1rem;
					flex-wrap: wrap;
					justify-content: center;
				}

				.footer-link {
					font-size: 0.9rem;
				}
			}
		</style>
	</body>
</html>
