---
import Layout from "../layouts/Layout.astro";

// TODO: fill these in with what you're actually up to
const now = [
	"studying physics and math at the university of toronto",
	"reading: the iliad, the sword of kaigen",
	"currently: wasting money on vintage bikes",
	"soon: going back to school..."
];

const interests = {
	pens: ["fountain pens", "ink"],
	cycling: ["bike wrenching", "fixed gear"],
	outdoors: ["camping", "hiking"],
	software: ["banging away at the puter"],
};

---

<Layout title="About - Oliver Huang">
	<main class="flex flex-col gap-8">
		<h1>about</h1>

		<section>
			<p class="mt-2">
				I&rsquo;m an undergraduate student studying physics and math at the
				University of Toronto.
			</p>
		</section>

		<section>
			<h2>now</h2>
			<ul>
				{
					now.map((item) => (
						<li>{item}</li>
					))
				}
			</ul>
		</section>

		<section>
			<h2>interests</h2>
			<ul>
				{
					Object.entries(interests).map(([category, items]) => (
						<li>
							{category} →
							{items.map((item, i) => (
								<>
									{item}
									{i < items.length - 1 && (
										<>
											<span class="split"> - </span>
										</>
									)}
								</>
							))}
						</li>
					))
				}
			</ul>
		</section>

		<section>
			<h2>colophon</h2>
			<p>
				stack → astro <span class="split">/</span> mdx
				<span class="split">/</span> vite <span class="split">/</span>
				vercel
				<br>
				fonts →
				<span style="font-family: 'EB Garamond', serif;">eb garamond</span>
				<span class="split"> - </span>
				<span style="font-family: 'CommitMono'; font-size: 16px"
					>commit mono</span
				>
				<span class="split"> - </span>
				<span style="font-family: 'Meddon'; font-size: 16px">meddon</span>
			</p>
			<p>
				Theme colours from <a href="https://stephango.com/flexoki"
					>flexoki</a
				>
				<span class="split">, </span> <a
					href="https://github.com/morhetz/gruvbox"
					>gruvbox</a
				>
				<span class="split">, </span> <a
					href="https://ethanschoonover.com/solarized/"
					>solarized</a
				>
				<span class="split">, </span> <a href="https://www.nordtheme.com"
					>nord</a
				>
				<span class="split">, </span> <a href="https://catppuccin.com"
					>catppuccin</a>. Use the theme switcher below to toggle between themes!
				<br>
				Site layout was inspired by <a href="https://refact0r.dev"
					><em>refact0r.dev</em></a
				>.
			</p>
			<div class="info pt-10 pb-4">
				<div
					class="colors flex flex-wrap justify-center overflow-hidden rounded-full"
				>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--bg-1); border: 2px solid var(--bg-2);"
					>
						bg
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--bg-2);"
					>
						bg-2
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--bg-3);"
					>
						bg-3
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--fg-3); color: var(--bg-1)"
					>
						fg-3
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--fg-2); color: var(--bg-1)"
					>
						fg-2
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--fg-1); color: var(--bg-1)"
					>
						fg-1
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--accent-cyan); color: var(--bg-1)"
					>
						cy
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--accent-magenta); color: var(--bg-1)"
					>
						ma
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--accent-blue); color: var(--bg-1)"
					>
						bl
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.color:first-child {
		border-top-left-radius: 9999px;
		border-bottom-left-radius: 9999px;
	}

	.color:last-child {
		border-top-right-radius: 9999px;
		border-bottom-right-radius: 9999px;
	}
</style>
