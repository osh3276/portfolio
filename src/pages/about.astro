---
import Layout from "../layouts/Layout.astro";

const content = {
	languages: {
		general: ["python", "java", "c#", "rust", "c++"],
		web: ["js", "ts", "html", "css"],
		scripting: ["bash", "zsh"],
		other: ["sql", "r"],
	},
	tech: {
		frontend: ["next.js", "react", "sveltekit", "tailwind"],
		backend: [
			"node.js",
			"express",
			"postgresql",
			"mongodb",
			"spring",
			"flask",
		],
		tools: ["docker", "postman", "git", "pgadmin", "dbeaver"],
		cloud: ["gcp", "aws"],
		os: ["macos tahoe"],
	},
};
---

<Layout title="About - Oliver Huang">
	<main class="flex flex-col gap-8">
		<h1>about</h1>

		<section>
			<p class="mt-2">
				I&rsquo;m an undergraduate student studying physics, math, and
				computer science at the University of Toronto. I study cool
				stuff and work on projects from time to time.
				<br />
				<br />
				I&rsquo;m also helping to organize hackathons. I organized my
				first in the summer of 2025: <a href="https://hack404.dev"
					>hack404</a
				>, a hackathon hosted at the University of Toronto.
			</p>
		</section>

		<section>
			<h2>languages</h2>
			<ul>
				{
					Object.entries(content.languages).map(
						([category, items]) => (
							<li>
								{category} →
								{items.map((item, i) => (
									<>
										{item}
										{i < items.length - 1 && (
											<>
												<span class="split">/</span>
											</>
										)}
									</>
								))}
							</li>
						),
					)
				}
			</ul>
		</section>

		<section>
			<h2>tech</h2>
			<ul>
				{
					Object.entries(content.tech).map(([category, items]) => (
						<li>
							{category} →
							{items.map((item, i) => (
								<>
									{item}
									{i < items.length - 1 && (
										<>
											<span class="split">/</span>
										</>
									)}
								</>
							))}
						</li>
					))
				}
			</ul>
		</section>

		<section>
			<h2>this site</h2>
			<ul>
				<p>theme colours from gruvbox.</p>
				<li>
					stack → astro <span class="split">/</span> mdx
					<span class="split">/</span> vite <span class="split"
						>/</span
					> github pages
				</li>
				<li>
					fonts →
					<span
						style="font-family: 'EB Garamond', serif;"
						class="tracking-normal">eb garamond</span
					>
					<span class="split">/</span>
					<span
						style="font-family: 'CommitMono'; font-size: 16px"
						class="tracking-normal">commit mono</span
					>
					<span class="split">/</span>
					
					<span
						style="font-family: 'Meddon'; font-size: 16px"
						class="tracking-normal">meddon</span
					>
				</li>
				<li>
					layout inspired by <a href="https://refact0r.dev"
						>refact0r</a
					>.
				</li>
			</ul>
			<div class="info pt-10 pb-4">
				<div
					class="colors flex flex-wrap justify-center overflow-hidden rounded-full"
				>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--bg-1); border: 2px solid var(--bg-2);"
					>
						bg
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--bg-2);"
					>
						bg-2
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--bg-3);"
					>
						bg-3
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--fg-3); color: var(--bg-1)"
					>
						fg-3
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--fg-2); color: var(--bg-1)"
					>
						fg-2
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--fg-1); color: var(--bg-1)"
					>
						fg-1
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--accent-1); color: var(--bg-1)"
					>
						a-1
					</div>
					<div
						class="py-1 color w-20 text-center font-['CommitMono',monospace] text-base border-2 border-transparent"
						style="background: var(--accent-2); color: var(--bg-1)"
					>
						a-2
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.color:first-child {
		border-top-left-radius: 9999px;
		border-bottom-left-radius: 9999px;
	}

	.color:last-child {
		border-top-right-radius: 9999px;
		border-bottom-right-radius: 9999px;
	}
</style>
