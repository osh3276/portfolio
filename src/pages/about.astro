---
import Layout from '../layouts/Layout.astro';

const content = {
	languages: {
		general: ['python', 'java', 'c#', 'rust', 'c++'],
		web: ['js', 'ts', 'html', 'css'],
		scripting: ['bash', 'zsh'],
		other: ['sql', 'r']
	},
	tech: {
		frontend: ['next.js', 'react', 'sveltekit', 'tailwind'],
		backend: ['node.js', 'express', 'postgresql', 'mongodb', 'spring', 'flask'],
		tools: ['docker', 'postman', 'git', 'pgadmin', 'dbeaver'],
		cloud: ['gcp', 'aws'],
		os: ['macos tahoe']
	}
};
---

<Layout title="About - Oliver Huang">
	<main>
		<h1 class="mb-10">about</h1>

		<section class="mb-10">
			<p class="mt-2">
				i'm an undergraduate student studying physics, math, and computer science at the university of toronto. i study
				cool stuff and make projects from time to time.
				<br />
				<br />
				i recently organized <a href="https://hack404.dev">hack404</a>, a hackathon at the university of toronto, where i
				led a team of students to develop a web application for managing hacker accounts and projects.
			</p>
		</section>

		<section>
			<h2>languages</h2>
			<ul>
				{Object.entries(content.languages).map(([category, items]) => (
					<li>
						{category} →
						{items.map((item, i) => (
							<>
								{item}
								{i < items.length - 1 && (
									<>
										<span class="split">/</span>&nbsp;
									</>
								)}
							</>
						))}
					</li>
				))}
			</ul>
		</section>

		<section>
			<h2>tech</h2>
			<ul>
				{Object.entries(content.tech).map(([category, items]) => (
					<li>
						{category} →
						{items.map((item, i) => (
							<>
								{item}
								{i < items.length - 1 && (
									<>
										<span class="split">/</span>&nbsp;
									</>
								)}
							</>
						))}
					</li>
				))}
			</ul>
		</section>

		<section>
			<h2>this site</h2>
			<ul>
				<li>
					stack → astro <span class="split">/</span> mdx
					<span class="split">/</span> vite <span class="split">/</span> github pages
				</li>
				<li>
					fonts →
					<span style="font-family: 'Spectral'" class="tracking-normal">spectral</span>
					<span class="split">/</span>
					eb garamond
					<span class="split">/</span>
					<span style="font-family: 'Overpass Mono'; font-size: 16px" class="tracking-normal">overpass mono</span>
				</li>
				<li>layout inspired by <a href="https://refact0r.dev">refact0r</a>.</li>
			</ul>
			<div class="info">
				<div class="colors">
					<div class="color" style="background: var(--bg-1); border: 2px solid var(--bg-2);">bg</div>
					<div class="color" style="background: var(--bg-2);">bg-2</div>
					<div class="color" style="background: var(--bg-3);">bg-3</div>
					<div class="color" style="background: var(--fg-3); color: var(--bg-1)">fg-3</div>
					<div class="color" style="background: var(--fg-2); color: var(--bg-1)">fg-2</div>
					<div class="color" style="background: var(--fg-1); color: var(--bg-1)">fg-1</div>
					<div class="color" style="background: var(--accent-1); color: var(--bg-1)">a-1</div>
					<div class="color" style="background: var(--accent-2); color: var(--bg-1)">a-2</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.colors {
		display: flex;
		justify-content: center;
		margin-top: 0.4rem;
		flex-wrap: wrap;
		border-radius: 15rem;
		overflow: hidden;
	}

	.color {
		display: inline-block;
		width: 5rem;
		text-align: center;
		font-family: 'Overpass Mono', monospace;
		font-size: 1em;
		border: 2px solid rgba(0, 0, 0, 0);
	}

	.color:first-child {
		border-top-left-radius: 15rem;
		border-bottom-left-radius: 15rem;
	}
	
	.color:last-child {
		border-top-right-radius: 15rem;
		border-bottom-right-radius: 15rem;
	}
</style>
