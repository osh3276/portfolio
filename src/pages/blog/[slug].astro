---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(dateString: string) {
	const date = new Date(dateString);
	return date
		.toLocaleDateString("en-US", {
			year: "numeric",
			month: "short",
			day: "numeric",
		})
		.toLowerCase();
}
---

<Layout title={`${post.data.title} - Oliver Huang`}>
	<main>
		<article class="post-body">
			<div class="mb-10 flex flex-col">
				<h1>{post.data.title}</h1>
				<div class="flex justify-between">
					{post.data.subtitle && <p>{post.data.subtitle}</p>}
					<p class="text-2xl">{formatDate(post.data.date)}</p>
				</div>
			</div>
			<div class="post-content">
				<Content />
			</div>
			<div class="flex justify-between mt-5">
				<p class="text-2xl text-right font-['Meddon']">osh</p>
			</div>
		</article>
	</main>
</Layout>

<style>
	/* only affects h2 inside this page’s content */
	:global(.post-body h2) {
		/* font-family: 'Spectral', sans-serif;
		font-size: 26px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-1); */
		margin-top: 2rem;
	}

	/* readable paragraph rhythm inside posts */
	:global(.post-body .post-content p) {
		margin: 0 0 1.1rem;
	}
</style>
