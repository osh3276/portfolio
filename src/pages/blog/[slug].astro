---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(dateString: string) {
	const date = new Date(dateString);
	return date
		.toLocaleDateString("en-US", {
			year: "numeric",
			month: "short",
			day: "numeric",
		})
		.toLowerCase();
}
---

<Layout title={`${post.data.title} - Oliver Huang`}>
	<main>
		<article class="post-body">
			<div class="mb-10 flex flex-col">
				<h1>{post.data.title}</h1>
				<div class="flex justify-between">
					{post.data.subtitle && <p>{post.data.subtitle}</p>}
					<p class="text-2xl">{formatDate(post.data.date)}</p>
				</div>
			</div>
			<div class="post-content">
				<Content />
			</div>
			<div class="flex justify-between mt-5">
				<p class="text-2xl text-right font-['Meddon']">osh</p>
			</div>
		</article>
	</main>
</Layout>

<style>
	/* only affects h2 inside this page’s content */
	:global(.post-body h2) {
		/* font-family: 'Spectral', sans-serif;
		font-size: 26px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-magenta); */
		margin-top: 2rem;
	}

	/* readable paragraph rhythm inside posts */
	:global(.post-body .post-content p) {
		margin: 0 0 1.1rem;
	}

	/* list styling */
	:global(.post-body .post-content ul) {
		list-style-type: disc;
		margin-left: 1.5rem;
		margin-bottom: 1.1rem;
	}

	:global(.post-body .post-content ol) {
		list-style-type: decimal;
		margin-left: 1.5rem;
		margin-bottom: 1.1rem;
	}

	:global(.post-body .post-content li) {
		margin-bottom: 0.5rem;
		line-height: 1.6;
	}

	:global(.post-body .post-content ul ul) {
		list-style-type: circle;
		margin-top: 0.5rem;
	}

	:global(.post-body .post-content ul ul ul) {
		list-style-type: square;
	}

	/* blockquote styling */
	:global(.post-body .post-content blockquote) {
		border-left: 4px solid var(--accent-cyan);
		margin: 1.5rem 0;
		padding: 0.5rem 1.25rem;
		background: var(--bg-2);
		border-radius: 0 0.5rem 0.5rem 0;
	}

	:global(.post-body .post-content blockquote p) {
		margin: 0;
		font-style: italic;
		color: var(--fg-2);
	}

	:global(.post-body .post-content blockquote cite) {
		display: block;
		margin-top: 0.5rem;
		font-style: normal;
		font-size: 0.9rem;
		color: var(--fg-3);
	}

	/* figure and image caption styling */
	:global(.post-body .post-content figure) {
		margin: 1.5rem auto;
		max-width: 75%;
		display: flex;
		flex-direction: column;
		align-items: center;
		border: 1px solid var(--fg-3);
		padding: 1rem;
		padding-bottom: 0;
	}

	:global(.post-body .post-content figure img) {
		width: 100%;
		height: auto;
	}

	:global(.post-body .post-content figcaption) {
		font-size: 1.1rem;
		color: var(--fg-2);
		text-align: center;
		font-style: italic;
		line-height: 1.2;
	}

	/* cyan links in blog posts */
	:global(.post-body .post-content a) {
		color: var(--accent-cyan);
		text-decoration: underline;
		text-decoration-color: var(--accent-cyan);
	}

	:global(.post-body .post-content a:hover) {
		filter: brightness(1.25);
	}
</style>
