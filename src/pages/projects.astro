---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

interface ProjectData {
	href: string;
	imageSrc: string;
	title: string;
	subtitle: string;
}

const projects: ProjectData[] = [
	{
		"href": "https://www.hackcanada.org/",
		"imageSrc": "/images/hackcanada.png",
		"title": "hackcanada",
		"subtitle": "website for hackcanada, a student organized hackathon in canada."
	},
	{
		"href": "https://hack404.dev/",
		"imageSrc": "/images/hack404.png",
		"title": "hack404",
		"subtitle": "website for hack404, a toronto-based hackathon."
	},
	{
		"href": "https://github.com/gooosexe/boids",
		"imageSrc": "/images/boids.png",
		"title": "boids",
		"subtitle": "a simple simulation of flocking behavior in birds."
	},
	{
		"href": "https://corkboard-gray.vercel.app/",
		"imageSrc": "/images/corkboard.png",
		"title": "corkboard",
		"subtitle": "a message board with an interesting twist."
	},
	{
		"href": "https://github.com/gooosexe/nbodysim",
		"imageSrc": "/images/nbodysim.png",
		"title": "nbodysim",
		"subtitle": "a simple 2d n-body simulation, created with matplotlib."
	},
	{
		"href": "https://github.com/osh3276/vibe-tune",
		"imageSrc": "/images/gemini.jpg",
		"title": "vibetune",
		"subtitle": "video-to-music ai generator powered by gemini 2.5 pro and lyria 2. made for spurhacks 2025."
	}
];
---

<Layout title="Projects - Oliver Huang">
	<div class="mx-auto mb-10 max-w-3xl pt-6">
		<h1 class="mb-10">projects</h1>
		<section>
			<p>a collection of some of the things i've made.</p>
		</section>
	</div>

	<section class="mx-auto max-w-5xl">
		<div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-8 p-6">
			{projects.map((project) => (
				<Card
					href={project.href}
					imageSrc={project.imageSrc}
					title={project.title}
					subtitle={project.subtitle}
				/>
			))}
		</div>
	</section>
</Layout>
