---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - Oliver Huang" showHeader={false} showFooter={false}>
	<div class="flex justify-center">
		<div class="flex min-h-dvh w-4/5 flex-col justify-center overflow-hidden leading-normal">
			<h1 class="text-5xl">oliver huang</h1>
			<p class="mt-2">physics, mathematics, and computer science student.</p>
			<nav class="mt-1 flex gap-10 text-xl">
				<a
					class="text-(--fg-1) underline decoration-transparent decoration-1 underline-offset-3 transition-colors duration-200 hover:decoration-(--fg-1)"
					href="/about"
				>
					about
				</a>
				<a
					class="text-(--fg-1) underline decoration-transparent decoration-1 underline-offset-3 transition-colors duration-200 hover:decoration-(--fg-1)"
					href="/projects"
				>
					projects
				</a>
				<a
					class="text-(--fg-1) underline decoration-transparent decoration-1 underline-offset-3 transition-colors duration-200 hover:decoration-(--fg-1)"
					href="/blog"
				>
					blog
				</a>
				<a
					class="text-(--fg-1) underline decoration-transparent decoration-1 underline-offset-3 transition-colors duration-200 hover:decoration-(--fg-1)"
					href="/contact"
				>
					contact
				</a>
			</nav>
		</div>
	</div>
</Layout>
