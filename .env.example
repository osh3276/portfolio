# Supabase Postgres - https://supabase.com
# Create a project, run supabase/schema.sql in the SQL editor, then grab:
#   Project Settings > API > Project URL and the publishable key.
# The publishable key is RLS-enforced: the policies in schema.sql make
# insert/select/delete work for anyone holding it. Keep it out of PUBLIC_*
# env vars and client code anyway - it can read and delete the list.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...

# Resend - https://resend.com/api-keys
# The free tier includes onboarding@resend.dev as a sender, but verify your
# own domain for deliverability and set NEWSLETTER_FROM below.
RESEND_API_KEY=re_xxxx

# Secret for signing confirmation links. Generate with: openssl rand -hex 32
# Any long random string works. Keep it secret, never commit it.
NEWSLETTER_SECRET=

# Sender address. The domain must be verified in Resend.
NEWSLETTER_FROM=Oliver Huang <newsletter@oliverhuang.ca>

# Public site URL, used for confirm/unsubscribe links.
# Locally: http://localhost:4321, in production: https://oliverhuang.ca
SITE_URL=http://localhost:4321

# Optional: default subject used by scripts/send-newsletter.mjs
# NEWSLETTER_SUBJECT=new post from oliver
